{
  "name": "rt-story-tracker",
  "productName": "RT Story Tracker",
  "version": "3.7.0",
  "description": "A place to write a book and keep everything around it, for Windows, macOS and Linux.",
  "author": "Recon Towers Dev Department <author@neogentrics.com>",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "main": "src/main/main.js",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "docx": "^9.15.2",
    "electron-updater": "^6.8.11",
    "fast-xml-parser": "^5.12.0",
    "fflate": "^0.8.3",
    "mammoth": "^1.13.0",
    "markdown-it": "^15.0.3",
    "parse5": "^8.1.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/courier-prime": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/literata": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@tiptap/core": "^3.32.2",
    "@tiptap/extension-text-align": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "diff": "^9.0.0",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "epubchecker": "^5.2.1",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.1"
  },
  "scripts": {
    "build:renderer": "node scripts/build-renderer.mjs",
    "start": "npm run build:renderer && electron .",
    "test": "node --test \"test/*.test.cjs\"",
    "test:e2e": "npm run build:renderer && node test/e2e/app.e2e.cjs && node test/e2e/write.e2e.cjs && node test/e2e/features.e2e.cjs && node test/e2e/safety.e2e.cjs && node test/e2e/export.e2e.cjs && node test/e2e/import.e2e.cjs && node test/e2e/folder.e2e.cjs && node test/e2e/lock.e2e.cjs && node test/e2e/link.e2e.cjs",
    "dist:win": "npm run build:renderer && electron-builder --win nsis --x64 --publish never",
    "dist:mac": "npm run build:renderer && electron-builder --mac dmg --arm64 --x64 --publish never",
    "dist:linux": "npm run build:renderer && electron-builder --linux AppImage deb --x64 --publish never",
    "check:install": "node scripts/check-install.cjs"
  },
  "build": {
    "appId": "com.recontowers.storytracker",
    "productName": "RT Story Tracker",
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/main/**",
      "src/shared/**",
      "dist/renderer/**",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "!node_modules/node-addon-api/**",
      "!node_modules/better-sqlite3-multiple-ciphers/deps/**",
      "!node_modules/better-sqlite3-multiple-ciphers/src/**",
      "!node_modules/better-sqlite3-multiple-ciphers/binding.gyp",
      "!node_modules/pdfjs-dist/**/*.map",
      "!node_modules/pdfjs-dist/build/**",
      "!node_modules/pdfjs-dist/web/**",
      "!node_modules/pdfjs-dist/image_decoders/**",
      "!node_modules/pdfjs-dist/legacy/web/**",
      "!node_modules/pdfjs-dist/legacy/image_decoders/**",
      "!node_modules/@napi-rs/**"
    ],
    "copyright": "Copyright © 2026 Recon Towers. All rights reserved.",
    "win": {
      "target": [
        "nsis"
      ],
      "files": [
        "!node_modules/better-sqlite3-multiple-ciphers/prebuilds/darwin-*",
        "!node_modules/better-sqlite3-multiple-ciphers/prebuilds/linux*",
        "!node_modules/better-sqlite3-multiple-ciphers/prebuilds/win32-arm64.node"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RT Story Tracker",
      "license": "LICENSE",
      "artifactName": "RTStoryTracker-${version}-Setup.exe"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "files": [
        "!node_modules/better-sqlite3-multiple-ciphers/prebuilds/win32-*",
        "!node_modules/better-sqlite3-multiple-ciphers/prebuilds/linux*"
      ]
    },
    "dmg": {
      "artifactName": "RTStoryTracker-${version}-mac-${arch}.dmg"
    },
    "linux": {
      "category": "Office",
      "target": [
        "AppImage",
        "deb"
      ],
      "artifactName": "RTStoryTracker-${version}-linux-${arch}.${ext}",
      "maintainer": "Recon Towers Dev Department <author@neogentrics.com>",
      "synopsis": "A place to write a book and keep everything around it",
      "files": [
        "!node_modules/better-sqlite3-multiple-ciphers/prebuilds/win32-*",
        "!node_modules/better-sqlite3-multiple-ciphers/prebuilds/darwin-*",
        "!node_modules/better-sqlite3-multiple-ciphers/prebuilds/linux*arm64.node"
      ]
    },
    "deb": {
      "packageCategory": "text"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "neogentrics",
        "repo": "StoryTracker",
        "releaseType": "release"
      }
    ],
    "fileAssociations": [
      {
        "ext": "rtstory",
        "name": "RT Story Tracker project",
        "description": "RT Story Tracker project",
        "role": "Editor"
      }
    ]
  },
  "homepage": "https://github.com/neogentrics/StoryTracker",
  "bugs": "https://github.com/neogentrics/StoryTracker/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/neogentrics/StoryTracker.git"
  }
}
